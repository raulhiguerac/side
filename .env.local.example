# Copiá este archivo a `.env.local` y completá los valores.
# `.env.local` está gitignoreado y NUNCA se commitea.
#
# Acá va solo lo que no puede ser determinista:
#  - secretos de terceros (permanentes)
#  - credenciales que hoy genera la infra al arrancar (temporales, ver notas)

# --- Terceros -----------------------------------------------------------
# Permanentes: nunca pasan al repo.
MAPBOX_API_KEY=
BREVO_API_KEY=
VUE_APP_GMAPS_KEY=

# --- Cloudflare R2 ------------------------------------------------------
# Todavía sin uso: lo consume el `make bootstrap` de la Fase 7.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
