# properties-service — config determinista de dev. Los secretos viven en .env.local (raíz).

# --- Persistencia
DATABASE_PROPERTIES_URL=postgresql://admin:admin@properties-ms-db:5432/properties-ms-db
REDIS_URL=redis://redis:6379/0

# --- Auth
KC_ISSUER=http://localhost:8180/realms/core
KC_JWKS_URL=http://keycloak:8080/realms/core/protocol/openid-connect/certs
OIDC_AUDIENCE=users-ms
ADMIN_ROLE=admin

# --- Servicios que consume
# Hostnames de la red dev-net. Si parás un servicio para correrlo a mano en el
# devcontainer, el otro deja de resolverlo: corré los dos a mano o ninguno.
CATALOG_URL=http://catalog:8001
USERS_URL=http://users:8000

# --- Storage (MinIO)
# Usuario propio con policy `properties-service`: property-images + properties.
# Nombres distintos de los AWS_* a proposito: el SDK de MLflow ocupa esos y los
# dos servicios comparten process env mientras corran en el devcontainer.
MINIO_URL=http://minio:9000
STORAGE_PUBLIC_BASE_URL=http://localhost:9000
ACCESS_KEY_PROPERTIES=side-properties-dev
SECRET_KEY_PROPERTIES=side-properties-dev-secret
BUCKET_PHOTOS_PROPERTIES=property-images
BUCKET_BULK_PROPERTIES=properties
