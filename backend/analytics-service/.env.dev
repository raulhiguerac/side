# analytics-service — config determinista de dev. Los secretos viven en .env.local (raíz).

# --- Persistencia
DATABASE_ANALYTICS_URL=postgresql://admin:admin@analytics-ms-db:5432/analytics-ms-db
REDIS_URL=redis://redis:6379/0

# --- Auth
KC_ISSUER=http://localhost:8180/realms/core
KC_JWKS_URL=http://keycloak:8080/realms/core/protocol/openid-connect/certs
OIDC_AUDIENCE=users-ms

# --- MLflow + MinIO como artifact store
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
MLFLOW_MODEL_URI=models:/bogota-avm@production
# El SDK de MLflow exige estos nombres. Usuario con policy `mlflow`: solo el
# bucket mlflow-artifacts, sin acceso al resto.
AWS_ACCESS_KEY_ID=side-mlflow-dev
AWS_SECRET_ACCESS_KEY=side-mlflow-dev-secret

# --- Worker Kafka (no lo necesita el web server)
KAFKA_SERVER=broker:29092
KAFKA_GROUP_ID=analytics-listing-consumer
KAFKA_TOPIC=listing-created
KAFKA_PREDICTIONS_TOPIC=price-predicted
KAFKA_DLQ_TOPIC=listing-created-dlq
# UUID de una cuenta concreta de tu DB actual: no es reproducible en otra PC.
# La Fase 5 lo fija desde el seed.
WORKER_PRINCIPAL=a7799b07-49bb-4f51-9536-37eb65de9b00
