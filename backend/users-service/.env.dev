# users-service — config determinista de dev. Los secretos viven en .env.local (raíz).
# Los hostnames resuelven dentro de la red dev-net del compose.

# --- Persistencia
DATABASE_URL=postgresql://admin:admin@users-ms-db:5432/identity_service_db
REDIS_URL=redis://redis:6379/0

# --- Keycloak
KEYCLOAK_URL=http://keycloak:8080
KC_REALM=core
KC_CLIENT_ID=users-ms-admin
KC_CLIENT_AUTH=users-ms-auth
KC_ISSUER=http://localhost:8180/realms/core
KC_JWKS_URL=http://keycloak:8080/realms/core/protocol/openid-connect/certs
OIDC_AUDIENCE=users-ms
ADMIN_ROLE=admin
# Los fija keycloak-init en cada `up`. El export del realm los enmascara como
# "**********", asi que no pueden vivir en el JSON.
KC_ADMIN_SECRET=users-ms-admin-dev-secret
KC_AUTH_SECRET=users-ms-auth-dev-secret

# --- Cache TTLs (segundos)
CACHE_TTL_SECONDS=240
PROFILE_CACHE_TTL_SECONDS=600
CACHE_REACTIVATION_TTL_SECONDS=900

# --- Storage (MinIO)
MINIO_URL=http://minio:9000
STORAGE_PUBLIC_BASE_URL=http://localhost:9000
PROFILE_PHOTOS_BUCKET=profile-photos
# Usuario propio con policy `users-service`: solo el bucket profile-photos.
# Lo crea minio-init; no son credenciales root.
ACCESS_KEY=side-users-dev
SECRET_KEY=side-users-dev-secret

# --- Uploads
ACCEPTED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp

# --- Email
# OJO: valor heredado del .env viejo, sin esquema ni TLD. Los links de reset
# de password que arma request_reset_password.py salen rotos con esto.
FRONT_BASE_URL=app.micasaenminutos
# BREVO_API_KEY -> .env.local
