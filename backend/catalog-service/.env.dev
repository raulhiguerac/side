# catalog-service — config determinista de dev. Los secretos viven en .env.local (raíz).

# --- Persistencia
DATABASE_CATALOG_URL=postgresql://admin:admin@catalog-ms-db:5432/catalog_service_db
REDIS_URL=redis://redis:6379/0

# --- Auth (valida JWT, no habla con la admin API de Keycloak)
KC_ISSUER=http://localhost:8080/realms/core
KC_JWKS_URL=http://keycloak:8080/realms/core/protocol/openid-connect/certs
OIDC_AUDIENCE=users-ms
ADMIN_ROLE=admin

# --- Georeferenciación
ORS_URL=http://router:8082/ors
# overpass-api.de responde 406 sin un User-Agent descriptivo.
OVERPASS_USER_AGENT=side-catalog-service/1.0 (contact: raul.higuera369@gmail.com)
# MAPBOX_API_KEY -> .env.local
