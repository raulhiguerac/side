.env
.env.local
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.coverage

# Cachés y artefactos de herramientas (no depender de su autoignore)
.venv/
venv/
.ruff_cache/
.pytest_cache/
.mypy_cache/
htmlcov/
coverage.xml
dist/
build/

# Editor y sistema
.idea/
.vscode/
*.swp
.DS_Store
*.csv
*.osm.pbf
*.geojson
**/.ipynb_checkpoints/

# Artefactos que viven en R2, no en git (ver .env.local.example y `make bootstrap`)
infra/seeds/*
!infra/seeds/.gitkeep
infra/ors/files/*
!infra/ors/files/.gitkeep
# Grafos de ORS: 176 MB derivados del .pbf, se reconstruyen solos.
infra/ors/graphs/*
!infra/ors/graphs/.gitkeep
# Modelo AVM y registro de MLflow: 48 MB, vienen de R2.
infra/mlflow/artifacts/*
!infra/mlflow/artifacts/.gitkeep
infra/mlflow/registry/*
!infra/mlflow/registry/.gitkeep

# Generados localmente: el lock lo escribe VS Code y los example-* los reescribe ORS al arrancar.
.devcontainer/devcontainer-lock.json
infra/ors/config/example-ors-config.*

# Scripts y artefactos para levantar los servicios en el devcontainer
up_dev_env.sh
down_dev_env.sh
logs/
.dev/
audit-report.txt

# caché de los hooks de Claude Code
.claude/.cache/
